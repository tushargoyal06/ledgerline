# Copy this file to .env for local development.
# Demo content is shown only by the local Vite dev server; production builds exclude it.
VITE_ENABLE_DEMO_CONTENT=true

# Add these only after creating your Supabase project. Use the public anon key only.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Add your real HTTPS domain after purchasing and connecting it.
# VITE_SITE_URL=https://your-real-domain.com
